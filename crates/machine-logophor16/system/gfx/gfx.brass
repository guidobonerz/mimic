// Package gfx: drawing for Panorama (step 11c) on mode 5, 1024 x 768
// with 8 bits a pixel. Surfaces live in chip RAM; filling, copying, text
// and shading go through Babbage's Lithograph.
//
// Chip RAM under Panorama: 0002:0000-001D:FFFF surfaces (a first-fit
// heap), 0020:0000 and 002C:0000 the two screens (768 KiB each),
// 0038:0000 the glyphs (256 x 8 x 16, built from Foundry's font at
// 0001:0000), 0038:8000 a row of 8 pixels of every colour, 0038:8800 the
// darkening table, 0038:8900 the lightening table, 0038:8A00 the
// pointer's sprite image, 0038:8B00 the shadow tables (soft: the desk's
// grey a fine step darker, other colours kept; edge: other colours a
// step darker, the desk's greys kept).
//
// Palette: 0-9 greys (black to white), 10-15 brass (dark to light),
// 16-231 a 6 x 6 x 6 colour cube, 232-250 more greys (the skin's tones
// under Panorama), 251-252 British racing green (title bars), 253-255
// the desk's shadow greys between Grey3 and Grey2. The oscilloscope theme replaces every colour by a green of its
// brightness.
package gfx

import "boiler"

// A surface: 8-bit pixels in chip RAM.
type Surface struct {
	Base  uintptr
	W, H  int
	Pitch int
	// drawing keeps inside this rectangle when clipOn (SetClip)
	cx0, cy0, cx1, cy1 int
	clipOn             bool
}

// A Lithograph job: its registers in order (SPEC.md 6.3).
type job struct {
	con0, con1             uint16
	aSeg, aOfs, bSeg, bOfs uint16
	dSeg, dOfs             uint16
	aPitch, bPitch, dPitch uint16
	w, h, key, color       uint16
	tSeg, tOfs, line       uint16
}

const (
	io      = uintptr(0xffff_0000)
	dmacon  = io + 0x0002
	vmode   = io + 0x0800
	fbseg   = io + 0x0802
	fbofs   = io + 0x0804
	pitch   = io + 0x0806
	border  = io + 0x080a
	vstat   = io + 0x081c
	sprseg  = io + 0x0820
	sprofs  = io + 0x0822
	palette = io + 0x1000
	sprites = io + 0x2000

	glyphs  = uintptr(0x0038_0000)
	colours = uintptr(0x0038_8000)
	darken  = uintptr(0x0038_8800)
	lighten = uintptr(0x0038_8900)
	soft    = uintptr(0x0038_8B00)
	edge    = uintptr(0x0038_8C00)
	pointer = uintptr(0x0038_8a00)
	font    = uintptr(0x0001_0000)

	heapStart = uintptr(0x0002_0000)
	heapEnd   = uintptr(0x001e_0000)

	opFill  = 0x0100 | 0x40
	opCopy  = 0x0c | 0x10 | 0x40
	opShade = 0x0300 | 0x20 | 0x40
	opLine  = 0x0200 | 0x40
	size8   = 1
	keyA    = 0x10

	// ScreenW, ScreenH: mode 5 (XGA, 8 bits a pixel).
	ScreenW = 1024
	ScreenH = 768
)

// Colours of the palette.
const (
	Black   = 0
	Grey1   = 1
	Grey2   = 2
	Grey3   = 3
	Grey4   = 4
	Grey5   = 5
	Grey6   = 6
	Grey7   = 7
	Grey8   = 8
	White   = 9
	Brass0  = 10
	Brass1  = 11
	Brass2  = 12
	Brass3  = 13
	Brass4  = 14
	Brass5  = 15
	Cube    = 16
	MoreGry = 232
	// British racing green and a darker one (title bars)
	RacingGreen     = 251
	RacingGreenDark = 252
	// the desk's shadow greys (253-255)
	DeskRamp = 253
)

var (
	mu      boiler.Mutex
	screens [2]Surface
	back    int
	heap    []block
	j       job
	rgb     [256]uint16 // the palette as set (brass theme)
	green   bool
)

type block struct {
	at   uintptr
	size uint32
	free bool
}

func run(j *job)
func consoleOff()

func poke16(a uintptr, v uint16) { *(*uint16)(a) = v }
func peek16(a uintptr) uint16    { return *(*uint16)(a) }
func poke8(a uintptr, v byte)    { *(*byte)(a) = v }
func peek8(a uintptr) byte       { return *(*byte)(a) }

func seg(a uintptr) uint16 { return uint16(a >> 16) }
func ofs(a uintptr) uint16 { return uint16(a) }

// Init sets mode 3 up: palette, tables, glyphs, screens, the pointer.
func Init() {
	consoleOff()
	poke16(dmacon, 0x8000|0x4000|0x01|0x02|0x20) // master, framebuffer, sprites, Lithograph
	buildPalette()
	buildGlyphs()
	heap = []block{{at: heapStart, size: uint32(heapEnd - heapStart), free: true}}
	for i := range 2 {
		screens[i] = Surface{Base: uintptr(0x0020_0000) + uintptr(i)*uintptr(0x000c_0000), W: ScreenW, H: ScreenH, Pitch: ScreenW}
	}
	back = 1
	screens[0].Fill(0, 0, ScreenW, ScreenH, Grey3)
	poke16(fbseg, seg(screens[0].Base))
	poke16(fbofs, 0)
	poke16(pitch, ScreenW)
	poke16(border, 0)
	SetTheme(green) // the palette and the monitor's tube (mode 5 on)
	buildPointer()
}

// ---- the palette ----

func rgb565(r, g, b int) uint16 {
	return uint16(r>>3)<<11 | uint16(g>>2)<<5 | uint16(b>>3)
}

func buildPalette() {
	for i := range 10 {
		v := i * 255 / 9
		rgb[i] = rgb565(v, v, v)
	}
	brass := [6][3]int{{70, 50, 20}, {110, 80, 35}, {150, 112, 50}, {185, 142, 66}, {212, 172, 92}, {236, 206, 140}}
	for i := range 6 {
		rgb[10+i] = rgb565(brass[i][0], brass[i][1], brass[i][2])
	}
	for r := range 6 {
		for g := range 6 {
			for b := range 6 {
				rgb[Cube+r*36+g*6+b] = rgb565(r*51, g*51, b*51)
			}
		}
	}
	for i := range RacingGreen - MoreGry {
		v := 8 + i*12
		rgb[MoreGry+i] = rgb565(v, v, v)
	}
	rgb[RacingGreen] = rgb565(0, 66, 37)
	rgb[RacingGreenDark] = rgb565(0, 44, 26)
	// the desk's grey (85) down to Grey2 (56) in fine steps
	for i := range 3 {
		v := 78 - 7*i
		rgb[DeskRamp+i] = rgb565(v, v, v)
	}
	// darker and lighter by about a fifth
	for i := range 256 {
		poke8(darken+uintptr(i), byte(shift(i, -1)))
		poke8(lighten+uintptr(i), byte(shift(i, 1)))
		poke8(soft+uintptr(i), byte(i))
		poke8(edge+uintptr(i), byte(shift(i, -1)))
	}
	poke8(darken+uintptr(RacingGreen), RacingGreenDark)
	poke8(darken+uintptr(RacingGreenDark), Black)
	poke8(edge+uintptr(RacingGreen), RacingGreenDark)
	poke8(edge+uintptr(RacingGreenDark), Black)
	poke8(lighten+uintptr(RacingGreen), Cube+0*36+2*6+1)
	poke8(lighten+uintptr(RacingGreenDark), RacingGreen)
	for i := range 3 {
		poke8(darken+uintptr(DeskRamp+i), Grey2)
		poke8(lighten+uintptr(DeskRamp+i), Grey3)
		poke8(edge+uintptr(DeskRamp+i), byte(DeskRamp+i))
	}
	// soft: Grey3, 253, 254, 255, Grey2
	poke8(soft+uintptr(Grey3), DeskRamp)
	poke8(soft+uintptr(DeskRamp), DeskRamp+1)
	poke8(soft+uintptr(DeskRamp+1), DeskRamp+2)
	poke8(soft+uintptr(DeskRamp+2), Grey2)
	poke8(edge+uintptr(Grey3), Grey3)
	poke8(edge+uintptr(Grey2), Grey2)
	SetTheme(false)
	// a row of 8 pixels in every colour
	for c := range 256 {
		for k := range 8 {
			poke8(colours+uintptr(c*8+k), byte(c))
		}
	}
}

// The colour a step darker (d < 0) or lighter.
func shift(i, d int) int {
	switch {
	case i < 10:
		return clamp(i+d, 0, 9)
	case i < 16:
		return clamp(i+d, 10, 15)
	case i < 232:
		c := i - Cube
		r, g, b := c/36, c/6%6, c%6
		return Cube + clamp(r+d, 0, 5)*36 + clamp(g+d, 0, 5)*6 + clamp(b+d, 0, 5)
	default:
		return clamp(i+3*d, MoreGry, 255)
	}
}

func clamp(v, lo, hi int) int {
	if v < lo {
		return lo
	}
	if v > hi {
		return hi
	}
	return v
}

// SetTheme puts the colours in: brass (false) or the oscilloscope's
// greens of the same brightness (true).
func SetTheme(oscilloscope bool) {
	green = oscilloscope
	for i := range 256 {
		c := rgb[i]
		if oscilloscope {
			r, g, b := int(c>>11)*8, int(c>>5&63)*4, int(c&31)*8
			y := (r*3 + g*6 + b) / 10
			c = rgb565(y/6, y, y/4)
		}
		poke16(palette+uintptr(2*i), c)
	}
	// the monitor's tube: green phosphor for the oscilloscope (VMODE bit
	// 13), the RGB tube otherwise
	if oscilloscope {
		poke16(vmode, 0x8005|0x2000)
	} else {
		poke16(vmode, 0x8005)
	}
}

// SetEntries sets palette entries from `from` on to RGB 5:6:5 words
// (little-endian bytes) and shows them in the theme; darker and lighter
// name each entry's shade-table neighbours (palette indices, for shadows
// and lit buttons).
func SetEntries(from int, colours, darker, lighter []byte) {
	n := len(colours) / 2
	for i := range n {
		rgb[from+i] = uint16(colours[2*i]) | uint16(colours[2*i+1])<<8
		poke8(darken+uintptr(from+i), darker[i])
		poke8(lighten+uintptr(from+i), lighter[i])
	}
	SetTheme(green)
}

// Oscilloscope tells whether the green theme is on.
func Oscilloscope() bool { return green }

// ---- glyphs and the pointer ----

func buildGlyphs() {
	for ch := range 256 {
		for row := range 16 {
			bits := peek8(font + uintptr(ch*16+row))
			for col := range 8 {
				v := byte(0)
				if bits&(byte(0x80)>>col) != 0 {
					v = 0xff
				}
				poke8(glyphs+uintptr(ch*128+row*8+col), v)
			}
		}
	}
}

func buildPointer() {
	// an arrow, 16 x 16: 1 = outline (black), 2 = inside (white)
	shape := [16]string{
		"1...............",
		"11..............",
		"121.............",
		"1221............",
		"12221...........",
		"122221..........",
		"1222221.........",
		"12222221........",
		"122222221.......",
		"1222222221......",
		"12222211111.....",
		"1221221.........",
		"121.1221........",
		"11..1221........",
		"1....1221.......",
		".....111........",
	}
	for y := range 16 {
		for x := range 16 {
			v := byte(0)
			switch shape[y][x] {
			case '1':
				v = Black + 1 // not 0: 0 is transparent
			case '2':
				v = White
			}
			poke8(pointer+uintptr(y*16+x), v)
		}
	}
	poke16(sprseg, seg(pointer))
	poke16(sprofs, ofs(pointer))
	poke16(sprites+4, 0) // image at the area's start
	poke16(sprites+6, 1) // 8 bits a pixel
	Pointer(ScreenW/2, ScreenH/2)
}

// Pointer moves the mouse pointer (sprite 0, 16 x 16).
func Pointer(x, y int) {
	poke16(sprites, 0x8000|1<<11|uint16(x+64))
	poke16(sprites+2, 1<<10|uint16(y+64))
}

// ---- chip RAM for surfaces ----

// NewSurface makes a w x h surface (nil when chip RAM is full).
func NewSurface(w, h int) *Surface {
	size := (uint32(w)*uint32(h) + 3) &^ 3
	mu.Lock()
	for i := range len(heap) {
		b := heap[i]
		if !b.free || b.size < size {
			continue
		}
		if b.size > size {
			rest := block{at: b.at + uintptr(size), size: b.size - size, free: true}
			heap = append(heap, block{})
			for k := len(heap) - 1; k > i+1; k-- {
				heap[k] = heap[k-1]
			}
			heap[i+1] = rest
		}
		heap[i] = block{at: b.at, size: size}
		mu.Unlock()
		return &Surface{Base: b.at, W: w, H: h, Pitch: w}
	}
	mu.Unlock()
	return nil
}

// Free gives a surface's chip RAM back.
func (s *Surface) Free() {
	mu.Lock()
	for i := range len(heap) {
		if heap[i].at == s.Base {
			heap[i].free = true
			// merge with the free neighbours
			if i+1 < len(heap) && heap[i+1].free {
				heap[i].size += heap[i+1].size
				copy(heap[i+1:], heap[i+2:])
				heap = heap[:len(heap)-1]
			}
			if i > 0 && heap[i-1].free {
				heap[i-1].size += heap[i].size
				copy(heap[i:], heap[i+1:])
				heap = heap[:len(heap)-1]
			}
			break
		}
	}
	mu.Unlock()
	free(s)
}

// FreeChip is the chip RAM left for surfaces (bytes) and its largest piece.
func FreeChip() (uint32, uint32) {
	var all, big uint32
	mu.Lock()
	for _, b := range heap {
		if b.free {
			all += b.size
			big = max(big, b.size)
		}
	}
	mu.Unlock()
	return all, big
}

// ---- screens ----

// Back is the screen being drawn (not shown).
func Back() *Surface { return &screens[back] }

// Flip shows the back screen from the next VBlank and waits for it.
func Flip() {
	s := &screens[back]
	poke16(fbseg, seg(s.Base))
	poke16(fbofs, ofs(s.Base))
	peek16(vstat) // forget an older VBlank
	for peek16(vstat)&4 == 0 {
		boiler.Yield()
	}
	back = 1 - back
}

// ---- drawing ----

func (s *Surface) addr(x, y int) uintptr {
	return s.Base + uintptr(uint32(y)*uint32(s.Pitch)+uint32(x))
}

// SetClip keeps all drawing on s inside the rectangle (NoClip: the
// whole surface again).
func (s *Surface) SetClip(x, y, w, h int) {
	s.cx0, s.cy0 = max(x, 0), max(y, 0)
	s.cx1, s.cy1 = min(x+w, s.W), min(y+h, s.H)
	s.clipOn = true
}

func (s *Surface) NoClip() {
	s.clipOn = false
}

// bounds: where drawing may go (x0, y0, x1, y1; x1 and y1 outside).
func (s *Surface) bounds() (int, int, int, int) {
	if s.clipOn {
		return s.cx0, s.cy0, s.cx1, s.cy1
	}
	return 0, 0, s.W, s.H
}

// clip x, y, w, h to the bounds; false when nothing is left.
func (s *Surface) clip(x, y, w, h *int) bool {
	x0, y0, x1, y1 := s.bounds()
	if *x < x0 {
		*w -= x0 - *x
		*x = x0
	}
	if *y < y0 {
		*h -= y0 - *y
		*y = y0
	}
	if *x+*w > x1 {
		*w = x1 - *x
	}
	if *y+*h > y1 {
		*h = y1 - *y
	}
	return *w > 0 && *h > 0
}

// Fill paints a rectangle.
func (s *Surface) Fill(x, y, w, h int, c byte) {
	if !s.clip(&x, &y, &w, &h) {
		return
	}
	mu.Lock()
	j = job{con0: opFill, con1: size8, w: uint16(w), h: uint16(h), color: uint16(c)}
	d := s.addr(x, y)
	j.dSeg, j.dOfs, j.dPitch = seg(d), ofs(d), uint16(s.Pitch)
	run(&j)
	mu.Unlock()
}

// Shade darkens (or lightens) a rectangle through a table.
func (s *Surface) Shade(x, y, w, h int, lighter bool) {
	t := darken
	if lighter {
		t = lighten
	}
	s.shadeBy(x, y, w, h, t)
}

// shadeBy maps a rectangle's pixels through the table at t.
func (s *Surface) shadeBy(x, y, w, h int, t uintptr) {
	if !s.clip(&x, &y, &w, &h) {
		return
	}
	mu.Lock()
	d := s.addr(x, y)
	j = job{con0: opShade, con1: size8, w: uint16(w), h: uint16(h)}
	j.bSeg, j.bOfs, j.bPitch = seg(d), ofs(d), uint16(s.Pitch)
	j.dSeg, j.dOfs, j.dPitch = seg(d), ofs(d), uint16(s.Pitch)
	j.tSeg, j.tOfs = seg(t), ofs(t)
	run(&j)
	mu.Unlock()
}

// Draw copies the w x h area of src at sx, sy to x, y.
func (s *Surface) Draw(src *Surface, sx, sy, w, h, x, y int) {
	s.draw(src, sx, sy, w, h, x, y, 0)
}

// DrawKey copies like Draw, leaving out the source's pixels of colour 0
// (the Lithograph's colour key on A).
func (s *Surface) DrawKey(src *Surface, sx, sy, w, h, x, y int) {
	s.draw(src, sx, sy, w, h, x, y, keyA)
}

// DrawFlip copies like Draw, the area mirrored in X and/or Y (the
// Lithograph's flips: LTHCON1 bits 2 and 3).
func (s *Surface) DrawFlip(src *Surface, sx, sy, w, h, x, y int, flipX, flipY bool) {
	flags := uint16(0)
	if flipX {
		flags |= 4
	}
	if flipY {
		flags |= 8
	}
	s.draw(src, sx, sy, w, h, x, y, flags)
}

func (s *Surface) draw(src *Surface, sx, sy, w, h, x, y int, flags uint16) {
	// clip against the destination, then the source moves along: from
	// the side clipped off, or for a mirrored walk from the other side
	x0, y0, x1, y1 := s.bounds()
	cl, cr, ct, cb := 0, 0, 0, 0
	if x < x0 {
		cl = x0 - x
	}
	if x+w > x1 {
		cr = x + w - x1
	}
	if y < y0 {
		ct = y0 - y
	}
	if y+h > y1 {
		cb = y + h - y1
	}
	if flags&4 != 0 {
		sx += cr
	} else {
		sx += cl
	}
	if flags&8 != 0 {
		sy += cb
	} else {
		sy += ct
	}
	x += cl
	y += ct
	w -= cl + cr
	h -= ct + cb
	if sx+w > src.W {
		w = src.W - sx
	}
	if sy+h > src.H {
		h = src.H - sy
	}
	if w <= 0 || h <= 0 || sx < 0 || sy < 0 {
		return
	}
	mu.Lock()
	a := src.addr(sx, sy)
	d := s.addr(x, y)
	j = job{con0: opCopy, con1: size8 | flags, w: uint16(w), h: uint16(h)}
	j.aSeg, j.aOfs, j.aPitch = seg(a), ofs(a), uint16(src.Pitch)
	j.dSeg, j.dOfs, j.dPitch = seg(d), ofs(d), uint16(s.Pitch)
	run(&j)
	mu.Unlock()
}

// Char puts a character in colour ink (the background stays).
func (s *Surface) Char(x, y int, ch byte, ink byte) {
	// the part of the cell inside the bounds
	gx, gy, gw, gh := x, y, 8, 16
	if !s.clip(&gx, &gy, &gw, &gh) {
		return
	}
	mu.Lock()
	a := glyphs + uintptr(int(ch)*128+(gy-y)*8+(gx-x))
	b := colours + uintptr(int(ink)*8)
	d := s.addr(gx, gy)
	j = job{con0: 0x08 | 0x10 | 0x20 | 0x40, con1: size8 | keyA, w: uint16(gw), h: uint16(gh)}
	j.aSeg, j.aOfs, j.aPitch = seg(a), ofs(a), 8
	j.bSeg, j.bOfs, j.bPitch = seg(b), ofs(b), 0
	j.dSeg, j.dOfs, j.dPitch = seg(d), ofs(d), uint16(s.Pitch)
	run(&j)
	mu.Unlock()
}

// Text writes a string (8 x 16 cells); the width it took.
func (s *Surface) Text(x, y int, str string, ink byte) int {
	for i := 0; i < len(str); i++ {
		s.Char(x+8*i, y, str[i], ink)
	}
	return 8 * len(str)
}

// Line draws a line (Bresenham, through the Lithograph).
func (s *Surface) Line(x0, y0, x1, y1 int, c byte) {
	if !s.clipLine(&x0, &y0, &x1, &y1) {
		return
	}
	dx, dy := x1-x0, y1-y0
	dir := uint16(0)
	if dx < 0 {
		dx = -dx
		dir |= 1
	}
	if dy < 0 {
		dy = -dy
		dir |= 2
	}
	if dy > dx {
		dir |= 4
	}
	mu.Lock()
	d := s.addr(x0, y0)
	j = job{con0: opLine, con1: size8, w: uint16(dx), h: uint16(dy), color: uint16(c), line: dir}
	j.dSeg, j.dOfs, j.dPitch = seg(d), ofs(d), uint16(s.Pitch)
	run(&j)
	mu.Unlock()
}

// Where a point lies against the bounds (Cohen-Sutherland).
func (s *Surface) outcode(x, y int) int {
	bx0, by0, bx1, by1 := s.bounds()
	code := 0
	if x < bx0 {
		code |= 1
	} else if x >= bx1 {
		code |= 2
	}
	if y < by0 {
		code |= 4
	} else if y >= by1 {
		code |= 8
	}
	return code
}

// clipLine cuts a line to the bounds; false when none of it is inside.
func (s *Surface) clipLine(x0, y0, x1, y1 *int) bool {
	bx0, by0, bx1, by1 := s.bounds()
	for range 8 {
		c0, c1 := s.outcode(*x0, *y0), s.outcode(*x1, *y1)
		if c0|c1 == 0 {
			return true
		}
		if c0&c1 != 0 {
			return false
		}
		c := c0
		if c == 0 {
			c = c1
		}
		// the crossing with the edge c names (32-bit products)
		dx, dy := int32(*x1-*x0), int32(*y1-*y0)
		var x, y int
		switch {
		case c&4 != 0:
			y = by0
			x = *x0 + int(dx*int32(y-*y0)/dy)
		case c&8 != 0:
			y = by1 - 1
			x = *x0 + int(dx*int32(y-*y0)/dy)
		case c&1 != 0:
			x = bx0
			y = *y0 + int(dy*int32(x-*x0)/dx)
		default:
			x = bx1 - 1
			y = *y0 + int(dy*int32(x-*x0)/dx)
		}
		if c == c0 {
			*x0, *y0 = x, y
		} else {
			*x1, *y1 = x, y
		}
	}
	return false
}

// Box draws a rectangle's outline.
func (s *Surface) Box(x, y, w, h int, c byte) {
	s.Fill(x, y, w, 1, c)
	s.Fill(x, y+h-1, w, 1, c)
	s.Fill(x, y, 1, h, c)
	s.Fill(x+w-1, y, 1, h, c)
}

// RoundFill paints a rectangle with corners of radius 3.
func (s *Surface) RoundFill(x, y, w, h int, c byte) {
	s.Fill(x+3, y, w-6, 1, c)
	s.Fill(x+1, y+1, w-2, 2, c)
	s.Fill(x, y+3, w, h-6, c)
	s.Fill(x+1, y+h-3, w-2, 2, c)
	s.Fill(x+3, y+h-1, w-6, 1, c)
}

// RoundBox draws the outline of a rectangle with rounded corners.
func (s *Surface) RoundBox(x, y, w, h int, c byte) {
	s.Fill(x+3, y, w-6, 1, c)
	s.Fill(x+3, y+h-1, w-6, 1, c)
	s.Fill(x, y+3, 1, h-6, c)
	s.Fill(x+w-1, y+3, 1, h-6, c)
	s.Fill(x+1, y+1, 2, 1, c)
	s.Fill(x+1, y+2, 1, 1, c)
	s.Fill(x+w-3, y+1, 2, 1, c)
	s.Fill(x+w-2, y+2, 1, 1, c)
	s.Fill(x+1, y+h-2, 2, 1, c)
	s.Fill(x+1, y+h-3, 1, 1, c)
	s.Fill(x+w-3, y+h-2, 2, 1, c)
	s.Fill(x+w-2, y+h-3, 1, 1, c)
}

// Shadow draws two thin lines below and right of a w x h area at x, y:
// the inner one darker than the outer. On the plain grey desk they take
// its fine greys (the soft table: two steps inside, three for a deep
// shadow such as the active window's, one outside); over other colours
// (the wallpaper, windows) the inner line is two steps darker, the outer
// one (the edge table).
func (s *Surface) Shadow(x, y, w, h, depth int) {
	steps := 2
	if depth > 6 {
		steps = 3
	}
	for k := 0; k < steps; k++ {
		s.shadeBy(x+1, y+h, w, 1, soft)
		s.shadeBy(x+w, y+1, 1, h, soft)
	}
	for k := 0; k < 2; k++ {
		s.shadeBy(x+1, y+h, w, 1, edge)
		s.shadeBy(x+w, y+1, 1, h, edge)
	}
	s.shadeBy(x+2, y+h+1, w, 1, soft)
	s.shadeBy(x+w+1, y+2, 1, h, soft)
	s.shadeBy(x+2, y+h+1, w, 1, edge)
	s.shadeBy(x+w+1, y+2, 1, h, edge)
}

// Put writes bytes into a surface from address a on (a row or part of
// one), split where it crosses a 64 KiB segment.
func Put(a uintptr, data []byte) {
	n := len(data)
	room := n
	// (int is 16 bits: the room left in the segment is counted in uint32)
	if left := uint32(0x10000) - uint32(a&0xffff); left < uint32(n) {
		room = int(left)
	}
	copy((*[0x7fff]byte)(a)[:room], data[:room])
	if room < n {
		copy((*[0x7fff]byte)(a + uintptr(room))[:n-room], data[room:])
	}
}
